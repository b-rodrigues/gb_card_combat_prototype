{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "screens/schema/battle.schema.json",
  "title": "Battle Screen Definition",
  "description": "Semantic source of truth for a battle screen layout. The web battle editor and the JSON->C compiler both read this; it must not be edited by hand except through the editor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "max_enemies", "allowed_categories", "enemy_positions", "timer_config", "hud_layout"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "description": "Unique identifier for this battle screen (lowercase, underscores only)."
    },
    "label": {
      "type": "string",
      "maxLength": 30,
      "description": "Human-readable label for the editor."
    },
    "max_enemies": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "Maximum number of enemies in this battle screen (1-3)."
    },
    "allowed_categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["minion", "elite", "boss"]
      },
      "description": "Enemy categories allowed in this battle screen."
    },
    "enemy_positions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 19,
            "description": "X position column on the battle grid (0-19)."
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17,
            "description": "Y position row on the battle grid (0-17)."
          }
        }
      },
      "description": "Positions for each enemy slot (must match max_enemies count)."
    },
    "timer_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overworld_ticks", "battle_ticks"],
      "properties": {
        "overworld_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "description": "Timer ticks per note in overworld mode (e.g., 43)."
        },
        "battle_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "description": "Timer ticks per note in battle mode (e.g., 17)."
        }
      }
    },
    "hud_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enemy_row_start", "enemy_row_step", "deck_row", "combo_row_start", "combo_row_step", "timer_row", "caret_x"],
      "properties": {
        "enemy_row_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 17,
          "description": "First enemy HP bar row (default: 2)."
        },
        "enemy_row_step": {
          "type": "integer",
          "minimum": 1,
          "description": "Row step between enemy HP bars (default: 1)."
        },
        "deck_row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 17,
          "description": "Player deck counter row (default: 7)."
        },
        "combo_row_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 17,
          "description": "First combo indicator row (default: 13)."
        },
        "combo_row_step": {
          "type": "integer",
          "minimum": 1,
          "description": "Row step between combo indicators (default: 1)."
        },
        "timer_row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 17,
          "description": "Timer bar row (default: 15)."
        },
        "caret_x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 19,
          "description": "Caret column for menu navigation (default: 3)."
        }
      }
    }
  }
}