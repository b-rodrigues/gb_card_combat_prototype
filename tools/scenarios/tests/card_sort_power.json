{
  "name": "card_sort_power",
  "test": true,
  "description": "Power-desc sort shows strongest cards first in the CARDS tab",
  "scenario_id": "NEW_GAME",
  "actions": [
    {
      "type": "press",
      "button": "START"
    },
    {
      "type": "wait",
      "frames": 5
    },
    {
      "type": "set_sort",
      "mode": "POWER_DESC"
    },
    {
      "type": "wait",
      "frames": 5
    }
  ],
  "assertions": [
    {
      "type": "screen",
      "expected": "ITEM"
    },
    {
      "type": "screen_row",
      "row": 6,
      "contains": "FIRE TM"
    },
    {
      "type": "screen_row",
      "row": 7,
      "contains": "IRON SW"
    },
    {
      "type": "screen_row",
      "row": 8,
      "contains": "HERB"
    }
  ],
  "initial_state": {
    "scene": "FIELD",
    "player": {
      "x": 4,
      "y": 4,
      "facing": "DOWN"
    },
    "seed": 1234,
    "inventory": {
      "IRON_SWORD": 1,
      "WOODEN_SHIELD": 1,
      "FIRE_TOME": 1,
      "POISON_DAGGER": 1,
      "HEALING_HERB": 1
    }
  }
}
