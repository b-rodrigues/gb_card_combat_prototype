{
  "name": "loot_instance_persistence",
  "test": true,
  "description": "Loot combos persist through SRAM save/load (docs/loot.md \u00a734): add one wood-plain-sword loot combo, save to Slot 1, load, then add the same combo again -- the second LOOT_CARD_ADDED must report copies-after == 2, proving the first survived the roundtrip.",
  "scenario_id": "NEW_GAME",
  "initial_state": {
    "scene": "FIELD",
    "player": {
      "x": 4,
      "y": 4,
      "facing": "DOWN"
    },
    "seed": 8410
  },
  "actions": [
    {
      "type": "wait",
      "frames": 5
    },
    {
      "type": "loot_add",
      "material": 0,
      "effect": 0,
      "weapon": 0
    },
    {
      "type": "wait",
      "frames": 2
    },
    {
      "type": "save",
      "slot": 1
    },
    {
      "type": "wait",
      "frames": 5
    },
    {
      "type": "load",
      "slot": 1
    },
    {
      "type": "wait",
      "frames": 5
    },
    {
      "type": "loot_add",
      "material": 0,
      "effect": 0,
      "weapon": 0
    },
    {
      "type": "wait",
      "frames": 5
    }
  ],
  "assertions": [
    {
      "type": "screen",
      "expected": "OVERWORLD"
    },
    {
      "type": "event_count",
      "event": "LOOT_CARD_ADDED",
      "count": 2
    },
    {
      "type": "event_arg",
      "event": "LOOT_CARD_ADDED",
      "index": 1,
      "value": 2
    }
  ]
}