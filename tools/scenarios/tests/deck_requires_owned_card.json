{
  "name": "deck_requires_owned_card",
  "test": true,
  "description": "deck_add_card rejects cards the player does not own: IRON_SWORD deck-add fails while unowned (no CARD_ADDED_TO_DECK), succeeds after the card enters the collection. Exactly 1 CARD_ADDED_TO_DECK event fires.",
  "actions": [
    {"type": "wait", "frames": 30},
    {"type": "deck_add", "card": "IRON_SWORD"},
    {"type": "wait", "frames": 2},
    {"type": "deck_add", "card": "AMULET"},
    {"type": "wait", "frames": 2},
    {"type": "add_item", "item": "IRON_SWORD", "quantity": 1},
    {"type": "wait", "frames": 2},
    {"type": "deck_add", "card": "IRON_SWORD"},
    {"type": "wait", "frames": 2}
  ],
  "assertions": [
    {"type": "screen", "expected": "OVERWORLD"},
    {"type": "event_count", "event": "CARD_ADDED_TO_DECK", "count": 1}
  ],
  "initial_state": {
    "scene": "FIELD",
    "player": {"x": 4, "y": 4, "facing": "DOWN"},
    "seed": 7004
  }
}
