{
  "name": "card_filter_type",
  "test": true,
  "description": "Type filter (ATTACK) shows only attack cards in the CARDS tab",
  "scenario_id": "NEW_GAME",
  "actions": [
    {
      "type": "press",
      "button": "START"
    },
    {
      "type": "wait",
      "frames": 5
    },
    {
      "type": "set_filter",
      "filter": "ATTACK"
    },
    {
      "type": "wait",
      "frames": 5
    }
  ],
  "assertions": [
    {
      "type": "screen",
      "expected": "ITEM"
    },
    {
      "type": "screen_row",
      "row": 6,
      "contains": "IRON SW"
    },
    {
      "type": "screen_row_not_contains",
      "row": 7,
      "contains": "WD SHLD"
    },
    {
      "type": "screen_row_not_contains",
      "row": 7,
      "contains": "HERB"
    }
  ],
  "initial_state": {
    "scene": "FIELD",
    "player": {
      "x": 4,
      "y": 4,
      "facing": "DOWN"
    },
    "seed": 1234,
    "inventory": {
      "IRON_SWORD": 1,
      "WOODEN_SHIELD": 1,
      "HEALING_HERB": 1
    }
  }
}
