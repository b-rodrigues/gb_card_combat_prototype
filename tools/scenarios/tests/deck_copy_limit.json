{
  "name": "deck_copy_limit",
  "test": true,
  "description": "deck_add_card enforces CardDefinition.max_copies: 3 HEALING_HERB copies deck successfully, the 4th is rejected; 2 FIRE_TOME copies deck, the 3rd is rejected. Exactly 5 CARD_ADDED_TO_DECK events fire.",
  "actions": [
    {"type": "wait", "frames": 30},
    {"type": "add_item", "item": "HEALING_HERB", "quantity": 3},
    {"type": "wait", "frames": 2},
    {"type": "deck_add", "card": "HEALING_HERB"},
    {"type": "wait", "frames": 2},
    {"type": "deck_add", "card": "HEALING_HERB"},
    {"type": "wait", "frames": 2},
    {"type": "deck_add", "card": "HEALING_HERB"},
    {"type": "wait", "frames": 2},
    {"type": "deck_add", "card": "HEALING_HERB"},
    {"type": "wait", "frames": 2},
    {"type": "add_item", "item": "FIRE_TOME", "quantity": 2},
    {"type": "wait", "frames": 2},
    {"type": "deck_add", "card": "FIRE_TOME"},
    {"type": "wait", "frames": 2},
    {"type": "deck_add", "card": "FIRE_TOME"},
    {"type": "wait", "frames": 2},
    {"type": "deck_add", "card": "FIRE_TOME"},
    {"type": "wait", "frames": 2}
  ],
  "assertions": [
    {"type": "screen", "expected": "OVERWORLD"},
    {"type": "event_count", "event": "CARD_ADDED_TO_DECK", "count": 5},
    {"type": "inventory", "item": "HEALING_HERB", "expected": 3},
    {"type": "inventory", "item": "FIRE_TOME", "expected": 2}
  ],
  "initial_state": {
    "scene": "FIELD",
    "player": {"x": 4, "y": 4, "facing": "DOWN"},
    "seed": 7003
  }
}
