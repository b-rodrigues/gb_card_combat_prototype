{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Level",
  "description": "Canonical level definition for the Game Boy RPG level editor and compiler.",
  "type": "object",
  "required": ["id", "name", "map", "layers", "player"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the level/scene (e.g. forest, town, field)"
    },
    "name": {
      "type": "string",
      "description": "Human-readable level title"
    },
    "map": {
      "type": "object",
      "required": ["width", "height", "tileset"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40,
          "description": "Width in tiles (<= WORLD_WIDTH 40)"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24,
          "description": "Height in tiles (<= WORLD_HEIGHT 24)"
        },
        "tileset": {
          "type": "string",
          "description": "Tileset identifier (e.g. forest, exterior, interior)"
        },
        "music": {
          "type": "string",
          "description": "Background music track enum (e.g. MUSIC_OVERWORLD, MUSIC_TOWN, MUSIC_DUNGEON)"
        },
        "map_id": {
          "type": "string",
          "description": "Engine MapId enum constant (e.g. MAP_FOREST, MAP_TOWN)"
        }
      }
    },
    "layers": {
      "type": "object",
      "required": ["terrain"],
      "properties": {
        "terrain": {
          "description": "2D tile grid array of strings (rows of semantic tile IDs) or list of block placements",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y", "width", "height", "tile"],
                "properties": {
                  "x": { "type": "integer" },
                  "y": { "type": "integer" },
                  "width": { "type": "integer" },
                  "height": { "type": "integer" },
                  "tile": { "type": "string" }
                }
              }
            }
          ]
        },
        "blocks": {
          "type": "array",
          "description": "Optional explicit list of SceneTerrainBlock rects",
          "items": {
            "type": "object",
            "required": ["x", "y", "width", "height", "tile"],
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" },
              "width": { "type": "integer" },
              "height": { "type": "integer" },
              "tile": { "type": "string" }
            }
          }
        }
      }
    },
    "collision": {
      "type": "object",
      "description": "Optional explicit collision overrides",
      "properties": {
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y", "walkable"],
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" },
              "walkable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "player": {
      "type": "object",
      "required": ["spawn"],
      "properties": {
        "spawn": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" },
            "facing": {
              "type": "string",
              "enum": ["UP", "DOWN", "LEFT", "RIGHT", "NORTH", "SOUTH", "WEST", "EAST"]
            }
          }
        }
      }
    },
    "exits": {
      "type": "array",
      "description": "List of scene transition exits/warps",
      "items": {
        "type": "object",
        "required": ["x", "y", "target_scene", "target_x", "target_y"],
        "properties": {
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "target_scene": { "type": "string" },
          "target_x": { "type": "integer" },
          "target_y": { "type": "integer" },
          "direction": { "type": "string" },
          "tile_char": { "type": "string" }
        }
      }
    },
    "objects": {
      "type": "array",
      "description": "Semantic objects and entities placed in the level",
      "items": {
        "type": "object",
        "required": ["id", "type", "position"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["player_spawn", "npc", "enemy", "chest", "door", "warp", "trigger", "item", "signpost"]
          },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" }
            }
          },
          "properties": {
            "type": "object"
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "description": "Semantic zones for LLM contextual awareness and gameplay triggers",
      "items": {
        "type": "object",
        "required": ["id", "bounds"],
        "properties": {
          "id": { "type": "string" },
          "bounds": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" },
              "width": { "type": "integer" },
              "height": { "type": "integer" }
            }
          },
          "description": { "type": "string" },
          "gameplay": {
            "type": "object",
            "properties": {
              "purpose": { "type": "string" },
              "difficulty": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
